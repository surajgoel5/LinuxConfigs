{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "plain",
          "foreground": "p:warn",
          "template": "\uf0e7 "
        },
        {
          "type": "os",
          "style": "powerline",
          "foreground": "p:ink",
          "background": "p:os",
          "template": " {{ .Icon }} ",
          "powerline_symbol": "\ue0b0",
          "leading_powerline_symbol": "\ue0b6"
        },
        {
          "type": "session",
          "style": "powerline",
          "foreground": "p:ink",
          "background": "p:session",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "p:ink",
          "background": "p:path",
          "template": " {{ .Path }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "home_icon": "~",
            "style": "agnoster_full",
            "folder_separator_icon": " \ue0b1 "
          }
        },
        {
          "type": "docker",
          "style": "diamond",
          "foreground": "p:ink",
          "background": "p:docker",
          "template": "\uf308 {{ .Context }}",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "cache": {
            "duration": "30s",
            "strategy": "session"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "foreground": "p:ink",
          "background": "p:git",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:warn{{ end }}",
            "{{ if gt .Ahead 0 }}p:good{{ end }}",
            "{{ if gt .Behind 0 }}p:bad{{ end }}"
          ],
          "template": "{{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }} \u2731{{ end }}{{ if gt .Ahead 0 }} \u2191{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} \u2193{{ .Behind }}{{ end }}",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "options": {
            "fetch_status": true,
            "branch_icon": "\ue0a0 "
          }
        },
        {
          "type": "python",
          "style": "diamond",
          "foreground": "p:ink",
          "background": "p:python",
          "template": "\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "default",
          "template": " \u276f"
        }
      ]
    }
  ],
  "palette": {
    "ink": "black",
    "os": "magenta",
    "session": "lightMagenta",
    "path": "lightBlue",
    "docker": "cyan",
    "git": "lightMagenta",
    "python": "blue",
    "warn": "yellow",
    "good": "lightGreen",
    "bad": "lightRed"
  }
}
