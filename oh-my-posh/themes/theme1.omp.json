{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "plain",
          "foreground": "p:orange",
          "template": "\uf0e7 "
        },
        {
          "type": "os",
          "style": "powerline",
          "foreground": "p:ink",
          "background": "p:white",
          "template": "{{ .Icon }} ",
          "powerline_symbol": "\ue0b0",
          "leading_powerline_symbol": "\ue0b6"
        },
        {
          "type": "session",
          "style": "powerline",
          "foreground": "p:ink",
          "background": "p:purple",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "p:ink",
          "background": "p:blue",
          "template": " {{ .Path }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "home_icon": "~",
            "style": "full"
          }
        },
        {
          "type": "docker",
          "style": "diamond",
          "foreground": "p:ink",
          "background": "p:cyan",
          "template": "\uf308 {{ .Context }}",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "cache": {
            "duration": "30s",
            "strategy": "session"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "foreground": "p:ink",
          "background": "p:teal",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if gt .Ahead 0 }}p:green{{ end }}",
            "{{ if gt .Behind 0 }}p:orange{{ end }}"
          ],
          "template": "{{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }} \u2731{{ end }}{{ if gt .Ahead 0 }} \u2191{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} \u2193{{ .Behind }}{{ end }}",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "options": {
            "fetch_status": true,
            "branch_icon": "\ue0a0 "
          }
        },
        {
          "type": "python",
          "style": "diamond",
          "foreground": "p:ink",
          "background": "p:pink",
          "template": "\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:white",
          "template": " \u276f"
        }
      ]
    }
  ],
  "palette": {
    "ink": "#1a1b26",
    "white": "#f2f4ff",
    "purple": "#bb9af7",
    "blue": "#7aa2f7",
    "cyan": "#7dcfff",
    "teal": "#73daca",
    "pink": "#f5c2e7",
    "green": "#9ece6a",
    "yellow": "#e0af68",
    "orange": "#ff9e64"
  }
}
