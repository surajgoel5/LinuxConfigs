{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "plain",
          "foreground": "p:root_icon",
          "template": "\uf0e7 "
        },
        {
          "type": "os",
          "style": "powerline",
          "foreground": "p:os_fg",
          "background": "p:os_bg",
          "template": "{{ .Icon }} ",
          "powerline_symbol": "\ue0b0",
          "leading_powerline_symbol": "\ue0b6"
        },
        {
          "type": "session",
          "style": "powerline",
          "foreground": "p:session_fg",
          "background": "p:session_bg",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "p:path_fg",
          "background": "p:path_bg",
          "template": " {{ .Path }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "home_icon": "~",
            "style": "full"
          }
        },
        {
          "type": "docker",
          "style": "diamond",
          "foreground": "p:docker_fg",
          "background": "p:docker_bg",
          "template": "\uf308 {{ .Context }}",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "cache": {
            "duration": "30s",
            "strategy": "session"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "foreground": "p:git_fg",
          "background": "p:git_clean",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:git_dirty{{ end }}",
            "{{ if gt .Ahead 0 }}p:git_ahead{{ end }}",
            "{{ if gt .Behind 0 }}p:git_behind{{ end }}"
          ],
          "template": "{{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }} \u2731{{ end }}{{ if gt .Ahead 0 }} \u2191{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} \u2193{{ .Behind }}{{ end }}",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "options": {
            "fetch_status": true,
            "branch_icon": "\ue0a0 "
          }
        },
        {
          "type": "python",
          "style": "diamond",
          "foreground": "p:python_fg",
          "background": "p:python_bg",
          "template": "\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:prompt_char",
          "template": " \u276f"
        }
      ]
    }
  ],
   "palette": {
    "root_icon": "yellow",

    "os_fg": "lightWhite",
    "os_bg": "black",

    "session_fg": "lightWhite",
    "session_bg": "blue",

    "path_fg": "black",
    "path_bg": "lightGreen",

    "docker_fg": "lightWhite",
    "docker_bg": "lightCyan",

    "git_fg": "black",
    "git_clean": "yellow",
    "git_dirty": "magenta",
    "git_ahead": "lightGreen",
    "git_behind": "lightRed",

    "python_fg": "black",
    "python_bg": "lightBlue",

    "prompt_char": "white"
  }
}
